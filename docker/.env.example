# Front-door settings for docker-compose.proxy.yml (§12).
#
#   cp docker/.env.example docker/.env
#
# Only read when the Caddy overlay is used. The app itself is configured through
# /data/config.json and PRIVATE_STOCK_* variables — see packages/core/src/config.ts.

# Which front door is in use is chosen by the compose overlay, not here:
# docker-compose.proxy.yml (public name, Let's Encrypt) or docker-compose.lan.yml (LAN only,
# Caddy's own CA). Each sets PS_TLS itself; the keys below are shared by both.
#
# On the LAN path PS_DOMAIN must carry its port -- e.g. PS_DOMAIN=mediaserver:8443 -- and
# PS_ACME_EMAIL is unused, so only PS_DOMAIN needs an answer.

# The hostname people and TVs will use. A No-IP DDNS name works; if other apps on the box
# already have one, private-stock gets its own rather than a
# path on one of theirs — a path would put this app's media behind another app's certificate
# and another app's front door.
#
# Carries the port whenever the front door is not on 443 -- which is the default, because the
# ports QTS leaves free are the ones that do not need it moved out of the way:
#
#   PS_DOMAIN=example.ddns.net:9443
PS_DOMAIN=example.ddns.net:9443

# The front door's ports on the NAS. The defaults dodge everything QTS occupies (80, 443, 8080,
# 8081, 8443), so no Control Panel change is needed to stand this up.
#
# PS_HTTP_PORT answers the Let's Encrypt HTTP-01 challenge that the Pi relays, and must match
# the port in the Pi's site block. PS_HTTPS_PORT serves the app and must match the port in
# PS_DOMAIN above. Set them to 80 and 443 for the standard layout, having moved QTS first.
PS_HTTP_PORT=8880
PS_HTTPS_PORT=9443

# Where Let's Encrypt sends expiry warnings. Never shown to anyone else.
PS_ACME_EMAIL=you@example.com

# The app, as seen from the Caddy container. Change this only if Caddy is proxying to another
# machine — e.g. PS_UPSTREAM=192.168.1.10:8842 when Caddy runs on the Pi and the app on the NAS.
PS_UPSTREAM=private-stock:8842

# LAN path only (docker-compose.lan.yml): the plain-HTTP port a TV fetches cast media from, and
# the NAS's address as the TV reaches it. An IP rather than a name -- a TV's DNS rarely knows the
# names a PC does -- so give the NAS a DHCP reservation. 8843 is clear of everything QTS takes.
# Never forward PS_CAST_PORT on the router: it is plain HTTP by design (§11).
PS_CAST_HOST=192.168.1.10
PS_CAST_PORT=8843
