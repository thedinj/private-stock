# Where `ship.sh` sends the image (§ docker/README.md, "Updating").
#
#   cp docker/deploy.env.example docker/deploy.env
#
# `deploy.env` is git-ignored, because it describes *this* machine's NAS rather than the
# project: a hostname, an account and a share path are yours, and a second install would want
# different ones. Nothing secret belongs in here either — scp asks for the password itself,
# which is the one part of the transfer that should not be written down anywhere.

# The NAS, as reached from this machine. A LAN address is the right answer even when the app
# also has a public name: the image is 600+ MB and has no business leaving the house.
PS_NAS_HOST=192.168.1.10

# The account SSH runs as. Must be able to reach the Container Station docker socket — on QTS
# that means an administrator.
PS_NAS_USER=admin

# QTS's SSH port, if it has been moved in Control Panel → Telnet / SSH.
PS_NAS_PORT=22

# Where the tarball and rollout.sh land. A directory on a data share, not /tmp: QTS clears
# /tmp on reboot and it is a ramdisk, which a 600 MB image will not fit in.
PS_NAS_DIR=/share/Container/private-stock/docker

# The image name. Matches `image:` in docker-compose.qnap.yml — change both together or the
# NAS will load an image the compose file never asks for.
PS_IMAGE=private-stock

# The build's own tag, beside `latest`. Left empty it is <date>-<short sha>, which is what
# makes "roll back to the one from Tuesday" a name rather than an image id hunt. Set it only
# to pin a particular build.
PS_TAG=

# Send docker-compose.qnap.yml along with the image. Off, because the copy on the NAS carries
# the share paths, PUID/PGID and memory cap it was started with, and this machine's copy may not —
# overwriting it during an update is how a deployment loses its mounts at the worst moment.
# Turn it on deliberately when the compose file is what changed -- or leave it off and pass
# `--send-compose` to the one run that needs it.
PS_SEND_COMPOSE=0

# How many builds to keep, here and on the NAS. Every ship leaves a ~640 MB tarball in
# dist-image/ and loads a ~2 GB image there, and nothing else ever removes them. Here the newest
# tarballs are kept; there, after a healthy rollout, the newest dated images (the rollback
# window) and only the newest tarball. The live image and the one it replaced always stay.
# 0 keeps everything.
PS_KEEP_BUILDS=3

# Extra options for ssh and scp, if the connection needs them. A QTS box with an old host key
# often does: PS_SSH_OPTS="-o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa"
PS_SSH_OPTS=
