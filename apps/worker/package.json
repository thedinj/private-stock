{
    "name": "@private-stock/worker",
    "version": "0.0.1",
    "private": true,
    "description": "Scanner, job queue runner, and ffmpeg pipelines",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --exclude \"**/*.integration.test.ts\"",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:watch": "vitest",
        "bench:seed": "tsx src/bench/seed.ts",
        "bench": "tsx src/bench/run.ts",
        "bench:embed": "tsx src/bench/embed.ts"
    },
    "dependencies": {
        "@private-stock/core": "workspace:*",
        "@private-stock/db": "workspace:*",
        "onnxruntime-node": "1.22.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/better-sqlite3": "^7.6.12",
        "@types/ffprobe-static": "^2.0.3",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^4.1.11",
        "better-sqlite3": "^11.8.1",
        "eslint": "^9.18.0",
        "ffmpeg-static": "^5.2.0",
        "ffprobe-static": "^3.1.0",
        "rimraf": "^6.1.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.53.0",
        "vitest": "^4.1.11"
    }
}
