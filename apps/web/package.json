{
    "name": "@private-stock/web",
    "version": "0.0.1",
    "private": true,
    "description": "Next.js UI, API routes, and media serving",
    "scripts": {
        "dev": "node ../../scripts/dev-web.mjs",
        "build": "next build",
        "start": "next start --port 8842",
        "clean": "rimraf .next .next-dev tsconfig.tsbuildinfo",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@mantine/core": "^7.15.3",
        "@mantine/form": "^7.15.3",
        "@mantine/hooks": "^7.15.3",
        "@mantine/spotlight": "^7.15.3",
        "@private-stock/core": "workspace:*",
        "@private-stock/db": "workspace:*",
        "@tanstack/react-query": "^5.68.2",
        "@tanstack/react-virtual": "^3.11.2",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^11.8.1",
        "hls.js": "^1.5.20",
        "jsonwebtoken": "^9.0.2",
        "next": "^15.1.6",
        "onnxruntime-node": "1.22.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sass": "^1.83.4",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@next/eslint-plugin-next": "^15.5.9",
        "@types/bcryptjs": "^2.4.6",
        "@types/chromecast-caf-sender": "1.0.10",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.6",
        "@types/react-dom": "^19.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "cross-env": "^7.0.3",
        "eslint": "^9.18.0",
        "eslint-config-next": "^15.1.6",
        "eslint-plugin-react-hooks": "^5.2.0",
        "postcss": "^8.4.49",
        "postcss-preset-mantine": "^1.17.0",
        "postcss-simple-vars": "^7.0.1",
        "rimraf": "^6.1.2",
        "typescript": "^5.7.2",
        "vitest": "^4.1.11"
    }
}
