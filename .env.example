# Secrets and per-machine overrides. Everything here is optional — config.json covers the
# rest, and anything an admin changes at runtime is a Setting row in the UI instead.

# Overrides config.json and skips the generated <dataDir>/secret.key.
# PRIVATE_STOCK_SECRET=

# PRIVATE_STOCK_PORT=8842
# PRIVATE_STOCK_DATA_DIR=./data
# PRIVATE_STOCK_MEDIA_DIR=./media
# PRIVATE_STOCK_LOG_LEVEL=debug
